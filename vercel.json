{
  "crons": [
    {
      "path": "/api/cron/crawl-regulatory",
      "schedule": "0 6,18 * * *"
    },
    {
      "path": "/api/cron/crawl",
      "schedule": "0 */3 * * *"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
